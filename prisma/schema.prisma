// The migrations under prisma/migrations are written by hand and are the source of truth for the database:
// they carry the topic-count constraint trigger, CHECK constraints and partial indexes this schema cannot
// express. This file describes the same tables to the generated client, and must be kept in step with them.

generator client {
  provider = "prisma-client-js"
  output   = "../src/store/generated"
}

// No `url` here: Prisma 7 rejects it in the schema. The connection string reaches the CLI through
// prisma.config.ts and the runtime client through the `PrismaPg` adapter in src/store/prisma.ts.
datasource db {
  provider = "postgresql"
}

enum AgentStatus {
  busy
  idle
  offline

  @@map("agent_status")
}

enum GrantLevel {
  read
  write

  @@map("grant_level")
}

enum MessageKind {
  post
  direct

  @@map("message_kind")
}

enum DeliveryState {
  queued
  delivered
  expired

  @@map("delivery_state")
}

enum TranscriptRole {
  user
  assistant
  tool_use
  tool_result
  system

  @@map("transcript_role")
}

enum CredentialKind {
  github
  azure
  claude
  // Nothing reads or writes this: the pasted Amazon Bedrock API key is gone from every surface, and
  // `CREDENTIAL_KINDS` in src/credentials/names.ts — which is what the application's `CredentialKind` is — does not
  // carry it. It stays in the type only because `20261107090000_bedrock_gone` leaves the label in place for the
  // length of a rolling deploy; the migration after it drops the value and this line with it.
  bedrock
  jenkins
  claude_md
  git_identity
  atlassian

  @@map("credential_kind")
}

enum CredentialVia {
  web
  cli
  pod

  @@map("credential_via")
}

enum VirtualAgentDesired {
  running
  stopped
  deleted

  @@map("virtual_agent_desired")
}

enum VirtualAgentStatus {
  requested
  provisioning
  awaiting_credentials
  awaiting_login
  cloning
  running
  stopping
  stopped
  failed

  @@map("virtual_agent_status")
}

enum VirtualAgentSize {
  small
  medium
  large

  @@map("virtual_agent_size")
}


enum ModelRoute {
  // No row carries this: `20261107090000_bedrock_gone` moved every one of them to `gateway`, and `ModelRoute` in
  // src/viewer/identity.ts has the two live routes only. Left in the type for the same rolling-deploy reason as
  // `CredentialKind.bedrock`, and dropped by the same later migration.
  bedrock
  gateway
  own_licence

  @@map("model_route")
}

enum VirtualAgentStopReason {
  user
  idle
  evening
  quota
  expired
  failed
  awaiting_owner

  @@map("virtual_agent_stop_reason")
}

enum VirtualAgentLoginPrompt {
  device_code
  paste_code

  @@map("virtual_agent_login_prompt")
}

enum VirtualAgentLoginState {
  pending
  completed
  expired
  failed

  @@map("virtual_agent_login_state")
}

enum ChannelMatch {
  any
  all

  @@map("channel_match")
}

/// A person, keyed by their Entra object id, which is the same for the web sign-in and the `az` token.
model User {
  oid         String   @id
  tid         String
  name        String
  email       String?
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  agents      Agent[]
  grantsGiven AgentGrant[] @relation("grantOwner")
  grantsHeld  AgentGrant[] @relation("grantee")
  messages    Message[]
  channels    Channel[]
  credentials   Credential[]
  virtualAgents VirtualAgent[]
  assistantConversations AssistantConversation[]
  assistantUploads       AssistantUpload[]
  assistantTemplates     AssistantTemplate[]
  assistantExportDefault AssistantExportDefault?
  assistantModelChoice   AssistantModelChoice?
  conversationsSharedWithThem AssistantConversationShare[] @relation("shareRecipient")
  conversationsTheyShared     AssistantConversationShare[] @relation("shareOwner")
  conversationsForkedToThem   AssistantConversationFork[]  @relation("forkRecipient")
  conversationsTheyForked     AssistantConversationFork[]  @relation("forkOwner")

  @@map("user")
}

model Agent {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerOid        String      @map("owner_oid")
  sessionId       String      @unique @map("session_id")
  name            String
  cwd             String?
  repo            String?
  branch          String?
  host            String?
  status          AgentStatus @default(idle)
  lastHeartbeatAt DateTime    @default(now()) @map("last_heartbeat_at") @db.Timestamptz(6)
  readCursor      BigInt      @default(0) @map("read_cursor")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  endedAt         DateTime?   @map("ended_at") @db.Timestamptz(6)
  /// The virtual agent whose session registered this agent, if any. Its launch token may act for this agent alone.
  virtualAgentId  String?     @map("virtual_agent_id") @db.Uuid
  /// The skills its session reported, as [{name, description}]. See src/agents/skills.ts.
  skills          Json        @default("[]")
  /// What its client claimed it understands of the hub's optional wire fields, as ["name"], or null from a client
  /// that reported nothing, which claims nothing. See src/agents/client-features.ts.
  clientFeatures  Json?       @map("client_features")
  /// The assistant conversation this agent is a session of, if any. Visible to and messageable by its owner only.
  assistantConversationId String? @map("assistant_conversation_id") @db.Uuid

  owner         User              @relation(fields: [ownerOid], references: [oid])
  authored      Message[]         @relation("authorAgent")
  received      Message[]         @relation("targetAgent")
  subscriptions Subscription[]
  deliveries    Delivery[]
  transcript    TranscriptEntry[]
  virtualAgent  VirtualAgent?     @relation("virtualAgentSessions", fields: [virtualAgentId], references: [id], onDelete: SetNull)
  currentOf     VirtualAgent[]    @relation("virtualAgentCurrent")
  assistantConversation AssistantConversation?   @relation("assistantConversationSessions", fields: [assistantConversationId], references: [id], onDelete: Cascade)
  currentOfConversation AssistantConversation[]  @relation("assistantConversationCurrent")
  questions             AgentQuestion[]

  @@index([ownerOid])
  @@index([name])
  @@map("agent")
}

/// Covers every agent the owner has, current and future.
model AgentGrant {
  ownerOid   String     @map("owner_oid")
  granteeOid String     @map("grantee_oid")
  level      GrantLevel
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  owner   User @relation("grantOwner", fields: [ownerOid], references: [oid])
  grantee User @relation("grantee", fields: [granteeOid], references: [oid])

  @@id([ownerOid, granteeOid])
  @@index([granteeOid])
  @@map("agent_grant")
}

model Topic {
  id            Int       @id @default(autoincrement())
  slug          String    @unique
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(6)

  messages      MessageTopic[]
  subscriptions Subscription[]

  @@index([slug(ops: raw("text_pattern_ops"))], map: "topic_slug_pattern_idx")
  @@map("topic")
}

model Message {
  id            BigInt      @id @default(autoincrement())
  kind          MessageKind
  authorAgentId String?     @map("author_agent_id") @db.Uuid
  authorOid     String      @map("author_oid")
  targetAgentId String?     @map("target_agent_id") @db.Uuid
  inReplyTo     BigInt?     @map("in_reply_to")
  title         String?
  body          String
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  authorAgent Agent?         @relation("authorAgent", fields: [authorAgentId], references: [id], onDelete: SetNull)
  author      User           @relation(fields: [authorOid], references: [oid])
  targetAgent Agent?         @relation("targetAgent", fields: [targetAgentId], references: [id], onDelete: SetNull)
  parent      Message?       @relation("thread", fields: [inReplyTo], references: [id], onDelete: SetNull)
  replies     Message[]      @relation("thread")
  topics      MessageTopic[]
  deliveries  Delivery[]
  transcript  TranscriptEntry[]
  uploads     AssistantUpload[]
  questionAnswers AgentQuestion[]

  @@map("message")
}

model MessageTopic {
  messageId BigInt @map("message_id")
  topicId   Int    @map("topic_id")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id])

  @@id([messageId, topicId])
  @@index([topicId, messageId])
  @@map("message_topic")
}

model Subscription {
  agentId   String   @map("agent_id") @db.Uuid
  topicId   Int      @map("topic_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id])

  @@id([agentId, topicId])
  @@index([topicId])
  @@map("subscription")
}

/// One row per direct message per target agent. Stays `queued` until the agent acks it, or `expired` once the agent has been offline too long.
model Delivery {
  messageId   BigInt        @map("message_id")
  agentId     String        @map("agent_id") @db.Uuid
  state       DeliveryState @default(queued)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  deliveredAt DateTime?     @map("delivered_at") @db.Timestamptz(6)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  agent   Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([messageId, agentId])
  @@index([agentId, state])
  @@map("delivery")
}

/// A saved view over a topic set. It holds no messages of its own.
model Channel {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerOid  String       @map("owner_oid")
  name      String
  topics    String[]
  match     ChannelMatch @default(any)
  shared    Boolean      @default(false)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)

  owner User @relation(fields: [ownerOid], references: [oid])

  @@index([ownerOid])
  @@map("channel")
}

/// One entry of an agent's Claude Code conversation, as its client uploaded it. `content`'s shape depends on `role`.
model TranscriptEntry {
  id         BigInt         @id @default(autoincrement())
  agentId    String         @map("agent_id") @db.Uuid
  sessionId  String         @map("session_id")
  entryKey   String         @map("entry_key")
  role       TranscriptRole
  content    Json
  truncated  Boolean        @default(false)
  redacted   Boolean        @default(false)
  messageId  BigInt?        @map("message_id")
  occurredAt DateTime       @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  agent   Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@unique([agentId, entryKey])
  @@index([agentId, occurredAt, id])
  @@index([agentId, id])
  @@index([createdAt, agentId])
  @@map("transcript_entry")
}

/// Which credentials a person has stored, and when and how each was last saved. Never the value: that is in the credentials vault under `secretName`.
model Credential {
  ownerOid     String         @map("owner_oid")
  kind         CredentialKind
  secretName   String         @map("secret_name")
  accountLabel String?        @map("account_label")
  updatedAt    DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedVia   CredentialVia  @map("updated_via")

  owner User @relation(fields: [ownerOid], references: [oid], onDelete: Cascade)

  @@id([ownerOid, kind])
  @@map("credential")
}

/// The development and test value store, sealed with AES-256-GCM. Never used in production.
model DevCredentialValue {
  secretName String   @id @map("secret_name")
  ciphertext Bytes
  iv         Bytes
  tag        Bytes
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("dev_credential_value")
}

/// A Claude Code session the hub runs for a person in the preview cluster. `desired` and `generation` are what the person asked for; `status` and `observedGeneration` are what the orchestrator and the pod last reported.
model VirtualAgent {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerOid            String                  @map("owner_oid")
  name                String
  desired             VirtualAgentDesired     @default(running)
  status              VirtualAgentStatus      @default(requested)
  statusDetail        String?                 @map("status_detail")
  statusChangedAt     DateTime                @default(now()) @map("status_changed_at") @db.Timestamptz(6)
  generation          Int                     @default(1)
  observedGeneration  Int                     @default(0) @map("observed_generation")
  /// How many claims in a row the orchestrator could not apply; 0 once one is observed.
  applyFailures       Int                     @default(0) @map("apply_failures")
  claimedBy           String?                 @map("claimed_by")
  claimedAt           DateTime?               @map("claimed_at") @db.Timestamptz(6)
  /// The cluster its StatefulSet and disk are on; kept when the claim is released.
  cluster             String?
  /// Generated by the database from the id: `va-<first 8 hex>`. Never written.
  statefulsetName     String                  @unique(map: "virtual_agent_statefulset_name_key") @default(dbgenerated()) @map("statefulset_name")
  /// Generated by the database from the id: `work-va-<first 8 hex>-0`, the claim template's PVC. Never written.
  pvcName             String                  @default(dbgenerated()) @map("pvc_name")
  launchTokenHash     Bytes?                  @unique(map: "virtual_agent_launch_token_hash_key") @map("launch_token_hash")
  launchTokenIssuedAt DateTime?               @map("launch_token_issued_at") @db.Timestamptz(6)
  agentId             String?                 @map("agent_id") @db.Uuid
  modelRoute          ModelRoute              @map("model_route")
  size                VirtualAgentSize        @default(small)
  /// The ports the pod reports listening on beyond loopback: at most 10 distinct, from 1024 to 65535, ascending.
  exposedPorts        Int[]                   @default([]) @map("exposed_ports")
  /// The ports the pod reports listening on loopback only, which the Service cannot reach; as `exposedPorts`.
  localOnlyPorts      Int[]                   @default([]) @map("local_only_ports")
  /// The workspace plugins the pod loads, as a sorted array of at most 20 names. See src/virtual-agents/plugins.ts.
  plugins             Json                    @default("[]")
  /// Stamped on the pod template; moved with `generation` by everything but a change of ports.
  podGeneration       Int                     @default(1) @map("pod_generation")
  /// What the pod last reported its volume holds. Null means it has not said, which is not the same as nothing.
  uploadsBytes        BigInt?                 @map("uploads_bytes")
  volumeUsedBytes     BigInt?                 @map("volume_used_bytes")
  volumeTotalBytes    BigInt?                 @map("volume_total_bytes")
  /// The largest uploads it holds, as [{upload_id, bytes}], at most 200. See src/assistant/upload-report.ts.
  uploadsFiles        Json                    @default("[]") @map("uploads_files")
  /// How many it holds in all, which is more than `uploadsFiles` names once it holds more than the cap.
  uploadsFilesTotal   Int?                    @map("uploads_files_total")
  uploadsReportedAt   DateTime?               @map("uploads_reported_at") @db.Timestamptz(6)
  /// How many conversation sessions the pod says it runs at once. The cap is in the pod template, so a running pod
  /// enforces the figure it booted with; null means it has not said. See src/assistant/memory-report.ts.
  sessionsMax         Int?                    @map("sessions_max")
  /// What the pod last reported its container cgroup says. Null means it has not said, not that it is idle.
  memoryLimitBytes    BigInt?                 @map("memory_limit_bytes")
  memoryCurrentBytes  BigInt?                 @map("memory_current_bytes")
  /// The high-water mark since it booted, shown as what the pod reached at its busiest.
  memoryPeakBytes     BigInt?                 @map("memory_peak_bytes")
  /// The part the kernel cannot reclaim, which the memory warning is computed from; see src/assistant/memory-report.ts.
  memoryAnonBytes     BigInt?                 @map("memory_anon_bytes")
  memoryReportedAt    DateTime?               @map("memory_reported_at") @db.Timestamptz(6)
  startedAt           DateTime                @default(now()) @map("started_at") @db.Timestamptz(6)
  lastActiveAt        DateTime?               @map("last_active_at") @db.Timestamptz(6)
  stoppedAt           DateTime?               @map("stopped_at") @db.Timestamptz(6)
  stopReason          VirtualAgentStopReason? @map("stop_reason")
  /// Why a failed agent failed, kept past the stop that clears status_detail; see src/virtual-agents/stop.ts.
  stopDetail          String?                 @map("stop_detail")
  diskExpiresAt       DateTime?               @map("disk_expires_at") @db.Timestamptz(6)
  diskDeletedAt       DateTime?               @map("disk_deleted_at") @db.Timestamptz(6)
  /// When the owner asked it to sign in to Azure, until its pod relays that sign-in. See src/virtual-agents/logins.ts.
  azureSignInRequestedAt DateTime?            @map("azure_sign_in_requested_at") @db.Timestamptz(6)
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)

  owner    User                @relation(fields: [ownerOid], references: [oid])
  agent    Agent?              @relation("virtualAgentCurrent", fields: [agentId], references: [id], onDelete: SetNull)
  sessions Agent[]             @relation("virtualAgentSessions")
  logins   VirtualAgentLogin[]
  conversations AssistantConversation[]
  lookups       AssistantLookup[]

  @@unique([ownerOid, name], map: "virtual_agent_owner_oid_name_key")
  @@index([ownerOid])
  @@map("virtual_agent")
}

/// Which cluster's orchestrator may claim: one row, renewed by every claim its holder makes.
model OrchestratorLease {
  id        Int      @id @db.SmallInt
  cluster   String
  renewedAt DateTime @map("renewed_at") @db.Timestamptz(6)

  @@map("orchestrator_lease")
}

/// A login the pod is waiting on the owner for. A pasted code is sealed under a key derived from `SESSION_SECRET`, and removed once the pod has read it.
model VirtualAgentLogin {
  virtualAgentId       String                  @map("virtual_agent_id") @db.Uuid
  kind                 CredentialKind
  prompt               VirtualAgentLoginPrompt
  userCode             String?                 @map("user_code")
  verificationUri      String                  @map("verification_uri")
  expiresAt            DateTime                @map("expires_at") @db.Timestamptz(6)
  state                VirtualAgentLoginState  @default(pending)
  pastedCodeCiphertext Bytes?                  @map("pasted_code_ciphertext")
  pastedCodeIv         Bytes?                  @map("pasted_code_iv")
  pastedCodeTag        Bytes?                  @map("pasted_code_tag")
  pastedCodeExpiresAt  DateTime?               @map("pasted_code_expires_at") @db.Timestamptz(6)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)

  virtualAgent VirtualAgent @relation(fields: [virtualAgentId], references: [id], onDelete: Cascade)

  @@id([virtualAgentId, kind])
  @@map("virtual_agent_login")
}

/// One HMCTS Assistant chat. Its agent is created with it, so messages queue before the pod starts a session for it.
model AssistantConversation {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerOid          String    @map("owner_oid")
  /// The virtual agent whose pod runs the conversation's sessions; null for a conversation that is a person's own
  /// local Claude Code session, which runs on their laptop and so has no pod.
  virtualAgentId    String?   @map("virtual_agent_id") @db.Uuid
  agentId           String?   @map("agent_id") @db.Uuid
  title             String?
  /// One of src/assistant/products.ts.
  product           String    @default("general")
  /// Every change of product, as [{product, at}].
  productHistory    Json      @default("[]") @map("product_history")
  /// Every answer the person stopped, as [{at}].
  stopHistory       Json      @default("[]") @map("stop_history")
  wakeRequestedAt   DateTime? @map("wake_requested_at") @db.Timestamptz(6)
  /// What the pod's supervisor last reported: starting, live or queued; null for no session.
  sessionState      String?   @map("session_state")
  sessionDetail     String?   @map("session_detail")
  lastActiveAt      DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(6)
  artefactTitle     String?   @map("artefact_title")
  artefactMarkdown  String    @default("") @map("artefact_markdown")
  artefactVersion   Int       @default(0) @map("artefact_version")
  /// user or agent.
  artefactUpdatedBy String?   @map("artefact_updated_by")
  artefactUpdatedAt DateTime? @map("artefact_updated_at") @db.Timestamptz(6)
  jiraExportId      String?   @map("jira_export_id") @db.Uuid
  jiraProject       String?   @map("jira_project")
  /// pending, done or failed; null before the first export.
  jiraStatus        String?   @map("jira_status")
  jiraKey           String?   @map("jira_key")
  jiraError         String?   @map("jira_error")
  jiraRequestedAt   DateTime? @map("jira_requested_at") @db.Timestamptz(6)
  jiraExportedAt    DateTime? @map("jira_exported_at") @db.Timestamptz(6)
  confluenceExportId    String?   @map("confluence_export_id") @db.Uuid
  confluenceSpaceId     String?   @map("confluence_space_id")
  confluenceSpaceKey    String?   @map("confluence_space_key")
  confluenceSpaceName   String?   @map("confluence_space_name")
  confluenceParentId    String?   @map("confluence_parent_id")
  confluenceParentTitle String?   @map("confluence_parent_title")
  /// pending, done or failed; null before the first export.
  confluenceStatus      String?   @map("confluence_status")
  confluencePageId      String?   @map("confluence_page_id")
  confluencePageTitle   String?   @map("confluence_page_title")
  confluenceError       String?   @map("confluence_error")
  confluenceRequestedAt DateTime? @map("confluence_requested_at") @db.Timestamptz(6)
  confluenceExportedAt  DateTime? @map("confluence_exported_at") @db.Timestamptz(6)
  /// Where a copy was forked from; null once the source is deleted, and for a conversation that is not a copy.
  forkedFromId          String?   @map("forked_from_id") @db.Uuid
  forkedFromOwnerName   String?   @map("forked_from_owner_name")
  forkedFromTitle       String?   @map("forked_from_title")
  forkedAt              DateTime? @map("forked_at") @db.Timestamptz(6)
  /// The words copied from the source, in src/assistant/forks.ts's shape.
  forkedThread          Json?     @map("forked_thread")
  forkedEarlierHidden   Boolean   @default(false) @map("forked_earlier_hidden")
  /// When the copied words went to the copy's session, with the first message sent in it.
  forkContextSentAt     DateTime? @map("fork_context_sent_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  owner        User             @relation(fields: [ownerOid], references: [oid])
  virtualAgent VirtualAgent?    @relation(fields: [virtualAgentId], references: [id], onDelete: Cascade)
  agent        Agent?           @relation("assistantConversationCurrent", fields: [agentId], references: [id], onDelete: SetNull)
  sessions     Agent[]          @relation("assistantConversationSessions")
  uploads      AssistantUpload[]
  shares       AssistantConversationShare[]
  forks        AssistantConversationFork[]
  forkedFrom   AssistantConversation?  @relation("forkedFrom", fields: [forkedFromId], references: [id], onDelete: SetNull)
  copies       AssistantConversation[] @relation("forkedFrom")

  @@index([ownerOid, lastActiveAt(sort: Desc)], map: "assistant_conversation_owner_active_idx")
  @@map("assistant_conversation")
}

/// A read-only share of one conversation with one named person. The list of rows is the whole of the access: a link
/// to a shared conversation resolves for the people named here and for nobody else. See src/access/rules.ts.
model AssistantConversationShare {
  conversationId String   @map("conversation_id") @db.Uuid
  recipientOid   String   @map("recipient_oid")
  /// The conversation's owner, who is the only person who can share it.
  sharedByOid    String   @map("shared_by_oid")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  recipient    User                  @relation("shareRecipient", fields: [recipientOid], references: [oid], onDelete: Cascade)
  sharedBy     User                  @relation("shareOwner", fields: [sharedByOid], references: [oid], onDelete: Cascade)

  @@id([conversationId, recipientOid])
  @@index([recipientOid, createdAt], map: "assistant_conversation_share_recipient_idx")
  @@map("assistant_conversation_share")
}

/// An offer to one named person of their own copy of one conversation, to continue in their own Assistant. The rows
/// are the whole of the offer, as a share's are. See src/assistant/fork-store.ts.
model AssistantConversationFork {
  conversationId String   @map("conversation_id") @db.Uuid
  recipientOid   String   @map("recipient_oid")
  /// The conversation's owner, who is the only person who can offer it.
  sharedByOid    String   @map("shared_by_oid")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  recipient    User                  @relation("forkRecipient", fields: [recipientOid], references: [oid], onDelete: Cascade)
  sharedBy     User                  @relation("forkOwner", fields: [sharedByOid], references: [oid], onDelete: Cascade)

  @@id([conversationId, recipientOid])
  @@index([recipientOid, createdAt], map: "assistant_conversation_fork_recipient_idx")
  @@map("assistant_conversation_fork")
}

/// A file attached to an Assistant message: the metadata, which outlives the bytes in `AssistantUploadPart`.
model AssistantUpload {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  ownerOid       String   @map("owner_oid")
  /// Stamped in the sending message's transaction; null while the person is still composing.
  messageId      BigInt?  @map("message_id")
  fileName       String   @map("file_name")
  /// What the pod writes it as. Decided by the hub and constrained in SQL, never built from `fileName`.
  storedName     String   @map("stored_name")
  mediaType      String   @map("media_type")
  bytes          BigInt
  /// pending, stored, fetched or expired.
  state          String   @default("pending")
  /// When the owner asked for the pod's own copy to go, and when a report of the pod's confirmed it had.
  podDeleteRequestedAt DateTime? @map("pod_delete_requested_at") @db.Timestamptz(6)
  podDeletedAt         DateTime? @map("pod_deleted_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  owner        User                  @relation(fields: [ownerOid], references: [oid], onDelete: Cascade)
  message      Message?              @relation(fields: [messageId], references: [id], onDelete: Cascade)
  parts        AssistantUploadPart[]

  @@index([conversationId, createdAt], map: "assistant_upload_conversation_idx")
  @@map("assistant_upload")
}

/// One of a person's own saved prompts, offered wherever the built-in templates in src/assistant/starters.ts are.
model AssistantTemplate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerOid  String   @map("owner_oid")
  name      String
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  owner User @relation(fields: [ownerOid], references: [oid])

  @@unique([ownerOid, name], map: "assistant_template_owner_name_key")
  @@index([ownerOid, name], map: "assistant_template_owner_idx")
  @@map("assistant_template")
}

/// Where a person's documents go by default, which the document panel starts from. See src/assistant/export-defaults.ts.
model AssistantExportDefault {
  ownerOid              String   @id @map("owner_oid")
  jiraProject           String?  @map("jira_project")
  jiraProjectName       String?  @map("jira_project_name")
  confluenceParentId    String?  @map("confluence_parent_id")
  confluenceParentTitle String?  @map("confluence_parent_title")
  confluenceSpaceId     String?  @map("confluence_space_id")
  confluenceSpaceKey    String?  @map("confluence_space_key")
  confluenceSpaceName   String?  @map("confluence_space_name")
  /// The titles above the parent page, from the space's top: at most 8 strings.
  confluenceAncestors   Json     @default("[]") @map("confluence_ancestors")
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  owner User @relation(fields: [ownerOid], references: [oid], onDelete: Cascade)

  @@map("assistant_export_default")
}

/// One search of a person's Jira or Confluence, answered by their pod. See "Atlassian lookups" in docs/agent-api.md.
model AssistantLookup {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  virtualAgentId String    @map("virtual_agent_id") @db.Uuid
  /// jira_project or confluence_page.
  kind           String
  query          String
  spaceKey       String?   @map("space_key")
  signIn         Boolean   @default(false) @map("sign_in")
  /// pending, done or failed.
  status         String    @default("pending")
  results        Json?
  /// signed_out, failed or superseded, when status is failed.
  error          String?
  detail         String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  answeredAt     DateTime? @map("answered_at") @db.Timestamptz(6)

  virtualAgent VirtualAgent @relation(fields: [virtualAgentId], references: [id], onDelete: Cascade)

  @@index([virtualAgentId, createdAt], map: "assistant_lookup_agent_idx")
  @@map("assistant_lookup")
}

/// One 4 MiB slice of an upload. Deleted by the sweep once the retention window closes, whether a pod fetched it or not.
model AssistantUploadPart {
  uploadId String @map("upload_id") @db.Uuid
  index    Int
  data     Bytes

  upload AssistantUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@id([uploadId, index])
  @@map("assistant_upload_part")
}

/// A question a session's model asked with AskUserQuestion, intercepted by the client's PreToolUse hook because
/// nobody is at that keyboard. See src/questions/questions.ts and "Questions" in docs/agent-api.md.
model AgentQuestion {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId         String    @map("agent_id") @db.Uuid
  sessionId       String    @map("session_id")
  toolUseId       String    @map("tool_use_id")
  /// The question set, as [{question, header, options: [{label, description}], multiSelect}].
  questions       Json
  askedAt         DateTime  @default(now()) @map("asked_at") @db.Timestamptz(6)
  answeredAt      DateTime? @map("answered_at") @db.Timestamptz(6)
  /// What the person chose, as {answers: [{labels, text}]}, one entry per question.
  answer          Json?
  /// The message their answer was sent as, or null once that message has gone.
  answerMessageId BigInt?   @map("answer_message_id")

  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  answerMessage Message? @relation(fields: [answerMessageId], references: [id], onDelete: SetNull)

  @@unique([agentId, toolUseId], map: "agent_question_tool_use_key")
  @@index([agentId, askedAt], map: "agent_question_agent_idx")
  @@map("agent_question")
}

/// The Claude model all of a person's Assistant chats run on. One row per person; no row means the default.
model AssistantModelChoice {
  ownerOid  String   @id @map("owner_oid")
  /// One of src/assistant/models.ts.
  model     String
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  owner User @relation(fields: [ownerOid], references: [oid], onDelete: Cascade)

  @@map("assistant_model_choice")
}
