{
  "name": "dtsse-agent-hub",
  "version": "0.0.1",
  "private": true,
  "description": "Relay and topic boards that let Claude Code sessions across HMCTS message each other, with a web UI behind Entra SSO.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn deps:up && yarn db:generate && yarn db:migrate && next dev",
    "build": "yarn build:app && yarn build:cli",
    "build:app": "next build",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build:client": "yarn workspace @hmcts-cft/agent-hub run build",
    "clean": "rm -rf .next dist && yarn workspace @hmcts-cft/agent-hub run clean",
    "start": "node .next/standalone/server.js",
    "deps:up": "docker compose up -d --wait",
    "deps:down": "docker compose down",
    "test": "vitest run && yarn workspace @hmcts-cft/agent-hub run test",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage && yarn workspace @hmcts-cft/agent-hub run test:coverage",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:a11y": "echo \"no build-time accessibility suite: the axe pass needs a deployed URL, and runs from test:fullfunctional\"",
    "test:smoke": "yarn e2e:browser && playwright test --config test/e2e/playwright.config.ts --grep @smoke",
    "test:functional": "yarn e2e:browser && playwright test --config test/e2e/playwright.config.ts --grep ${E2E_TEST_SCOPE:-@regression}",
    "test:fullfunctional": "yarn e2e:browser && playwright test --config test/e2e/playwright.config.ts --grep ${E2E_TEST_SCOPE:-@nightly}",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.cli.json --noEmit && tsc -p tsconfig.e2e.json --noEmit && yarn workspace @hmcts-cft/agent-hub run typecheck",
    "db:generate": "prisma generate",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:studio": "prisma studio",
    "e2e:browser": "playwright install chromium",
    "test:e2e": "yarn e2e:browser && playwright test --config test/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@azure/identity": "4.14.0",
    "@azure/keyvault-secrets": "4.11.2",
    "@hmcts-cft/cloud-native-platform": "2.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "jose": "6.2.13",
    "next": "16.4.3",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "autoprefixer": "10.6.1",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "playwright-core": "1.64.1",
    "postcss": "8.5.31",
    "prisma": "7.10.1",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "resolutions": {
    "applicationinsights": "3.17.0",
    "pg": "8.23.1"
  },
  "dependenciesMeta": {
    "@prisma/engines": {
      "built": true
    },
    "prisma": {
      "built": true
    }
  }
}
