{
  "name": "dtsse-agent-hub",
  "version": "0.0.1",
  "private": true,
  "description": "Relay and topic boards that let Claude Code sessions across HMCTS message each other, with a web UI behind Entra SSO.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "yarn@4.14.1",
  "scripts": {
    "dev": "yarn deps:up && yarn db:generate && yarn db:migrate && next dev",
    "build": "yarn build:app && yarn build:cli",
    "build:app": "next build",
    "build:cli": "tsc -p tsconfig.cli.json",
    "clean": "rm -rf .next dist",
    "start": "node .next/standalone/server.js",
    "deps:up": "docker compose up -d --wait",
    "deps:down": "docker compose down",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:a11y": "echo \"no build-time accessibility suite: the axe pass needs a deployed URL, and runs from test:fullfunctional\"",
    "test:smoke": "yarn e2e:browser && playwright test --config test/e2e/playwright.config.ts --grep @smoke",
    "test:functional": "yarn e2e:browser && playwright test --config test/e2e/playwright.config.ts --grep ${E2E_TEST_SCOPE:-@regression}",
    "test:fullfunctional": "yarn e2e:browser && playwright test --config test/e2e/playwright.config.ts --grep ${E2E_TEST_SCOPE:-@nightly}",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.cli.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:studio": "prisma studio",
    "e2e:browser": "playwright install chromium",
    "test:e2e": "yarn e2e:browser && playwright test --config test/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@azure/identity": "4.13.2",
    "@azure/keyvault-secrets": "4.11.2",
    "@hmcts-cft/cloud-native-platform": "2.0.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "jose": "6.1.0",
    "next": "16.3.8",
    "openid-client": "6.8.8",
    "pg": "8.20.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "0.0.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@biomejs/biome": "2.4.15",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.12.3",
    "@types/pg": "8.23.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.6",
    "autoprefixer": "10.4.19",
    "jsdom": "29.1.1",
    "playwright-core": "1.56.1",
    "postcss": "8.4.39",
    "prisma": "7.8.0",
    "tailwindcss": "3.4.19",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.0.12",
    "vitest": "4.1.6"
  },
  "resolutions": {
    "pg": "8.20.0"
  }
}
