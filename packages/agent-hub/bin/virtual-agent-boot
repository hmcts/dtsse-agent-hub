#!/usr/bin/env bash
# Stage 0 of an agent-hub virtual agent pod. It only gets the workspace onto the volume: GitHub auth,
# then a clone or fast-forward of cft-workspace, then an upgrade of this client to the published one, then
# it hands over to stage 1, this package's virtual-agent/entrypoint.sh.
#
# The pod's `command` is this bin's name, resolved by the kubelet with no shell against the image's
# PATH, and npm's global bin directory is not on it (the devcontainer image reaches node through
# nvm, sourced by .bashrc). cft-workspace's Dockerfile therefore symlinks this script into
# /usr/local/bin after installing the package.
#
# Needs AGENT_HUB_URL, AGENT_HUB_VIRTUAL_AGENT_ID and AGENT_HUB_LAUNCH_TOKEN. Never prints a secret:
# the launch token goes to curl through a 0600 header file, the GitHub token through stdin.

set -euo pipefail

# Stage 1 ships in this package, so every symlink in the way has to be followed first: npm installs a bin as a
# symlink from <prefix>/bin, and cft-workspace's Dockerfile links that into /usr/local/bin again, so neither
# unresolved directory holds the package's virtual-agent/. `readlink -f` would do it in one call but macOS ships
# a BSD readlink without -f, so the loop walks the chain itself, as bin/agent-hub does.
target="${BASH_SOURCE[0]}"
while [ -L "$target" ]; do
    link="$(readlink "$target")"
    case "$link" in
        /*) target="$link" ;;
        *) target="$(cd "$(dirname "$target")" && pwd)/$link" ;;
    esac
done
PACKAGE="$(cd "$(dirname "$target")/.." && pwd)"

# Stage 1 takes the workspace from the environment rather than from its own location, so it is exported here
# whether the pod template set it or this default stands in.
export VIRTUAL_AGENT_WORKSPACE="${VIRTUAL_AGENT_WORKSPACE:-/workspace/cft-workspace}"
WORKSPACE="$VIRTUAL_AGENT_WORKSPACE"
REPO_URL="${VIRTUAL_AGENT_REPO:-git@github.com:hmcts/cft-workspace.git}"
# Every required variable is checked before it is used: under `set -u` an expansion of an unset one aborts with
# bash's own "unbound variable" instead of the message here.
: "${AGENT_HUB_URL:?AGENT_HUB_URL is not set}"
VID="${AGENT_HUB_VIRTUAL_AGENT_ID:?AGENT_HUB_VIRTUAL_AGENT_ID is not set}"
: "${AGENT_HUB_LAUNCH_TOKEN:?AGENT_HUB_LAUNCH_TOKEN is not set}"
# Every trailing slash goes, as the TS client strips them: one `%/` would leave `https://hub//api/…`.
HUB="$AGENT_HUB_URL"
while [ "${HUB%/}" != "$HUB" ]; do HUB="${HUB%/}"; done
: "${HUB:?AGENT_HUB_URL is only slashes}"
export GIT_TERMINAL_PROMPT=0

log() { printf '%s virtual-agent-boot: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2; }

TMP="$(mktemp -d)"
chmod 700 "$TMP"
trap 'rm -rf "$TMP"' EXIT
trap 'log "terminated during boot"; exit 0' TERM INT
printf 'Authorization: Bearer %s\n' "$AGENT_HUB_LAUNCH_TOKEN" >"$TMP/auth"
chmod 600 "$TMP/auth"

HUB_STATUS=""

# hub_call METHOD PATH [JSON]: the response body goes to $TMP/body, the HTTP status to HUB_STATUS
# ("000" when the hub was not reached).
hub_call() {
    local args=(-sS -o "$TMP/body" -w '%{http_code}' --max-time 20 -X "$1" -H @"$TMP/auth")
    [[ $# -ge 3 ]] && args+=(-H 'Content-Type: application/json' --data-binary "$3")
    HUB_STATUS=$(curl "${args[@]}" "$HUB$2" 2>"$TMP/curl.err") || HUB_STATUS="000"
}

# Retries until the hub answers something other than a network error, 429 or 5xx, at most $1 times
# (0: forever), backing off from 2s to a minute.
hub_retry() {
    local max="$1" attempt=0 delay=2
    shift
    while :; do
        hub_call "$@"
        case "$HUB_STATUS" in
            000 | 429 | 5??) ;;
            *) return 0 ;;
        esac
        attempt=$((attempt + 1))
        if [[ "$max" -gt 0 && "$attempt" -ge "$max" ]]; then
            log "$1 $2: giving up after $attempt attempts (last status $HUB_STATUS)"
            return 1
        fi
        log "$1 $2: hub answered $HUB_STATUS; retrying in ${delay}s"
        sleep "$delay"
        delay=$((delay * 2 > 60 ? 60 : delay * 2))
    done
}

report() {
    local body
    if [[ $# -ge 2 ]]; then
        body=$(jq -cn --arg phase "$1" --arg detail "$2" '{phase: $phase, detail: $detail}')
    else
        body=$(jq -cn --arg phase "$1" '{phase: $phase}')
    fi
    hub_retry 8 POST "/api/virtual/$VID/status" "$body" || true
    [[ "$HUB_STATUS" == "204" ]] || log "status $1 not recorded (hub answered $HUB_STATUS)"
}

github_credential() {
    hub_retry 0 GET "/api/virtual/$VID/credentials/github"
    case "$HUB_STATUS" in
        200) jq -r '.value // empty' "$TMP/body" ;;
        404) return 0 ;;
        *) log "github credential: hub answered $HUB_STATUS"; return 1 ;;
    esac
}

# workspace.yaml's clone URLs are SSH; the pod has no key, so git fetches them over HTTPS with gh's token.
configure_git() {
    local from
    for from in "git@github.com:" "ssh://git@github.com/"; do
        git config --global --get-all url."https://github.com/".insteadOf 2>/dev/null | grep -qxF "$from" ||
            git config --global --add url."https://github.com/".insteadOf "$from"
    done
}

# gh validates the token as it stores it, so a revoked one fails here.
gh_login_with_token() {
    if printf '%s\n' "$1" | env -u GH_TOKEN -u GITHUB_TOKEN gh auth login --hostname github.com --git-protocol https --with-token >/dev/null 2>"$TMP/gh.err"; then
        gh auth setup-git --hostname github.com
        return 0
    fi
    log "the stored GitHub token was refused: $(head -c 300 "$TMP/gh.err")"
    return 1
}

sync_detail=""

# What git says when GitHub will not let the signed-in account read the repo. For a repo the
# account cannot see, GitHub answers "Repository not found" rather than 403.
git_auth_error() {
    grep -qiE 'could not read (Username|Password)|terminal prompts disabled|Authentication failed|Invalid username or (password|token)|Repository not found|returned error: 40[13]' "$1"
}

checkout_workspace() {
    local delay=5 err reported=""
    if [[ ! -d "$WORKSPACE/.git" ]]; then
        mkdir -p "$(dirname "$WORKSPACE")"
        until git clone --quiet --filter=blob:none "$REPO_URL" "$WORKSPACE" 2>"$TMP/git.err"; do
            err=$(head -c 300 "$TMP/git.err" | tr '\n' ' ')
            log "clone of $REPO_URL failed: $err; retrying in ${delay}s"
            # The owner has to act on this one (the GitHub account needs access to the repo), so they
            # are told once per distinct error rather than left watching "Starting".
            if git_auth_error "$TMP/git.err" && [[ "$err" != "$reported" ]]; then
                report awaiting_credentials "github: the signed-in GitHub account cannot clone $REPO_URL; it needs read access to the repo ($err)"
                reported="$err"
            fi
            rm -rf "$WORKSPACE"
            sleep "$delay"
            delay=$((delay * 2 > 120 ? 120 : delay * 2))
        done
        log "cloned $REPO_URL into $WORKSPACE"
        [[ -z "$reported" ]] || report provisioning "cloned cft-workspace"
        return 0
    fi
    if ! git -C "$WORKSPACE" fetch --quiet origin 2>"$TMP/git.err"; then
        sync_detail="cft-workspace: fetch failed, kept the local checkout ($(head -c 200 "$TMP/git.err"))"
        return 0
    fi
    local branch default
    branch=$(git -C "$WORKSPACE" rev-parse --abbrev-ref HEAD 2>/dev/null || echo HEAD)
    default=$(git -C "$WORKSPACE" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/master)
    default="${default#origin/}"
    if [[ -n "$(git -C "$WORKSPACE" status --porcelain 2>/dev/null)" ]]; then
        sync_detail="cft-workspace: local changes on $branch, not updated"
    elif [[ "$branch" != "$default" ]]; then
        sync_detail="cft-workspace: on branch $branch, not updated from $default"
    elif ! git -C "$WORKSPACE" merge --ff-only --quiet "origin/$default" 2>"$TMP/git.err"; then
        sync_detail="cft-workspace: $branch cannot fast-forward to origin/$default, kept the local checkout"
    else
        log "fast-forwarded $WORKSPACE to origin/$default"
    fi
}

load_node() {
    export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
    set +u
    # shellcheck disable=SC1091
    [[ -s "$NVM_DIR/nvm.sh" ]] && . "$NVM_DIR/nvm.sh"
    set -u
    command -v node >/dev/null
}

# A pod's client is the one the devcontainer image baked in, so without this a client release would reach pods
# only after an image rebuild and a Flux digest bump; cft-workspace's post-start.sh gives a laptop the same
# refresh on every container start. Called as late as the handover allows, because this script is one of the
# package's own bins and the install replaces the file bash is reading: it is the first line of the compound
# command that ends in the `exec`, so bash has parsed the whole of the rest of this script before npm runs.
#
# It is called above that command's trap clearing, not below it, so the TERM handler covers the install: the
# fetch bound is per request and an install makes several, so this runs for minutes, and an agent stopped from
# the UI meanwhile should log "terminated during boot" and exit 0 rather than let the kubelet's TERM kill bash
# at its default disposition — a 143 with no log line and npm orphaned mid-reify. $TMP is therefore still
# present while npm runs, and nothing here uses it: the output goes to a local.
#
# The registry is set for the @hmcts-cft scope alone. The hmcts-lib feed holds nothing else, so a bare
# --registry would send the first public package there and 404. The feed allows anonymous reads, which is what
# makes the install possible with no credential and no .npmrc.
#
# No sudo: npm's global prefix is nvm's, under $HOME and owned by the pod user. cft-workspace's Dockerfile
# symlinks both bins into /usr/local/bin, where the kubelet finds this one having no shell to source nvm, and
# those links point into nvm's version-specific bin directory — the same path a reinstall writes, so they go on
# resolving to the new copy.
#
# Never fatal: whatever happens here the pod carries on and boots on the client the image carries.
# VIRTUAL_AGENT_SKIP_CLIENT_UPGRADE pins whatever runs this bin to that copy, to debug a particular version; the hub
# gives a pod a fixed environment, so pinning one means setting the variable on its StatefulSet.
upgrade_client() {
    local out version
    case "${VIRTUAL_AGENT_SKIP_CLIENT_UPGRADE:-}" in
        [Tt][Rr][Uu][Ee] | 1 | [Yy][Ee][Ss])
            log "client upgrade skipped: VIRTUAL_AGENT_SKIP_CLIENT_UPGRADE is set"
            return 0
            ;;
    esac
    # Only the device-code branch above needs node, so nvm may not have been sourced yet.
    load_node || { log "client upgrade skipped: node is not on PATH"; return 0; }
    command -v npm >/dev/null || { log "client upgrade skipped: npm is not on PATH"; return 0; }
    # Bounded, because npm would otherwise allow five minutes a request and two retries, and a feed that hangs
    # would hold the agent at "Starting" for as long as that takes.
    if ! out=$(npm install -g --no-fund --no-audit --fetch-timeout=60000 --fetch-retries=1 \
        --@hmcts-cft:registry=https://pkgs.dev.azure.com/hmcts/Artifacts/_packaging/hmcts-lib/npm/registry/ \
        "@hmcts-cft/agent-hub@latest" 2>&1); then
        log "could not upgrade the agent-hub client, keeping the image's: $(printf '%s' "$out" | tr '\n' ' ' | head -c 300)"
        return 0
    fi
    # The client has no version command, so npm is asked what is now installed. A `--parseable --long` line is
    # `<path>:<name>@<version>`, then a realpath when the two differ, then any of EXTRANEOUS, INVALID and
    # OVERRIDDEN — so the pkgid is taken by position, or a pod npm considers extraneous logs that word as its
    # version, and this line is the only record of which client the pod booted on.
    version=$(npm ls -g --depth=0 --parseable --long "@hmcts-cft/agent-hub" 2>/dev/null | cut -d: -s -f2 || true)
    if [[ -n "$version" ]]; then
        log "agent-hub client is $version"
    else
        log "agent-hub client reinstalled; npm said: $(printf '%s' "$out" | tr '\n' ' ' | head -c 200)"
    fi
}

log "virtual agent $VID booting"
report provisioning

# The checkout's shim comes first so a checkout can pin an older client than the image carries; otherwise the
# installed package's own bin, which is all there is before the first clone. The shim has to answer `help`
# before it is preferred: a volume may hold a checkout whose shim needs an install this stage has not done, and
# a sign-in run through a broken client never completes, so the pod would back off forever in
# `awaiting_credentials` while a working client sat on PATH.
agent_hub_client() {
    local shim="$WORKSPACE/scripts/agent-hub"
    if [[ -x "$shim" ]] && "$shim" help >/dev/null 2>&1; then
        printf '%s\n' "$shim"
        return 0
    fi
    command -v agent-hub
}

configure_git
token=""
until token=$(github_credential); do sleep 10; done
github_missing="no GitHub token stored"
if [[ -n "$token" ]]; then
    if gh_login_with_token "$token"; then
        github_missing=""
    else
        github_missing="the stored GitHub token was refused"
    fi
fi
unset token

# cft-workspace is internal, so the clone needs GitHub auth: without a usable stored token, the
# device-code sign-in runs first, from the installed client if there is no checkout yet.
if [[ -n "$github_missing" ]]; then
    report awaiting_credentials "github: $github_missing; relaying a device-code sign-in to the owner"
    load_node || { report failed "node is not installed in the image"; exit 1; }
    client=$(agent_hub_client) ||
        { report failed "the image has no agent-hub client: neither $WORKSPACE/scripts/agent-hub nor an agent-hub on PATH"; exit 1; }
    log "signing in to GitHub with $client"
    # One call, which relays a bounded number of codes itself and tells the hub when none of them was completed.
    # There is no loop around it on purpose: each code replaces the one before it on the owner's screen, so an
    # owner who is not going to sign in should be asked once and then told, not handed a fresh code every few
    # minutes for as long as the pod runs. A stored token is the other way in, so that is what the pod waits for,
    # and waiting costs one GET rather than another device code nobody uses.
    if ! "$client" virtual github-login; then
        report failed "github: nobody completed the sign-in. Paste a GitHub token at $HUB/hub/settings/credentials, or stop and start this agent to be sent another code."
        log "github sign-in did not complete; waiting for a stored GitHub token rather than asking again"
        until token=$(github_credential) && [[ -n "$token" ]] && gh_login_with_token "$token"; do
            sleep 30
        done
        unset token
        log "signed in with the GitHub token the owner stored"
    fi
    gh auth setup-git --hostname github.com
    report provisioning
fi

checkout_workspace
[[ -n "$sync_detail" ]] && { log "$sync_detail"; report provisioning "$sync_detail"; }

# The handover, as one compound command so that bash has parsed every line of it before the install inside it
# replaces the file it is reading.
{
    upgrade_client

    # Stage 1 is this package's own, so a pod gets the runtime it was published with rather than whatever the
    # checkout happens to carry. Resolved after the upgrade, not before: the global prefix is in the container
    # filesystem rather than on the volume, so a pod whose image client predates the runtime installs one here
    # on every boot, and resolving first would send every one of those boots to the checkout until the pod
    # image itself was rebuilt. The checkout's copy is the fallback for the boot that has neither, and goes
    # once every pod image floor carries a client that ships one.
    entrypoint="$PACKAGE/virtual-agent/entrypoint.sh"
    if [[ ! -x "$entrypoint" ]]; then
        entrypoint="$WORKSPACE/.devcontainer/virtual-agent/entrypoint.sh"
    fi
    if [[ ! -x "$entrypoint" ]]; then
        report failed "neither this agent-hub client nor the cft-workspace checkout has an executable virtual-agent/entrypoint.sh"
        exit 1
    fi
    log "handing over to $entrypoint"
    rm -rf "$TMP"
    trap - EXIT TERM INT
    exec "$entrypoint"
}
