#!/usr/bin/env bash
# Connect Claude Code sessions to agent-hub (hmcts/dtsse-agent-hub): direct messages
# between agents and people, topic boards, and an upload of each enabled session's transcript
# (agent-hub transcript off|on|status). Opt-in per session via /enable-comms, or
# automatic for interactive sessions when AGENT_HUB_AUTO_ENABLE is true.
#
# Usage: agent-hub <command> [args]     (agent-hub help for the list)
#
# The work is done by the compiled, dependency-free Node CLI beside this script. `hook` runs
# in every workspace session, so a session that never enabled comms costs one file test
# here and never starts node. With auto-enable on, SessionStart and UserPromptSubmit
# start node for a session that is neither enabled nor opted out. UserPromptContext
# starts it only when the stop worker has held a feed note for the next prompt, and
# PreToolUse only in a pod or an Assistant conversation, where a tool prompt cannot be
# answered by anyone.

set -u

# The CLI is found relative to this file, so every symlink in the way has to be followed first: npm installs a
# bin as a symlink from <prefix>/bin, and the unresolved directory holds no dist/. `readlink -f` would do it in
# one call but macOS ships a BSD readlink without -f, so the loop walks the chain itself; it costs one `[ -L ]`
# test for a real path, which is what the hooks always have.
target="${BASH_SOURCE[0]}"
while [ -L "$target" ]; do
    link="$(readlink "$target")"
    case "$link" in
        /*) target="$link" ;;
        *) target="$(cd "$(dirname "$target")" && pwd)/$link" ;;
    esac
done
HERE="$(cd "$(dirname "$target")" && pwd)"
CLI="${AGENT_HUB_CLI_JS:-$HERE/../dist/cli.js}"
# How the CLI names itself in the commands it tells anyone to run. A wrapper that wants its own spelling sets
# this before calling. Otherwise the bare name is used only when it resolves to something: a machine whose only
# agent-hub is cft-workspace's `scripts/agent-hub` shim was told to run `agent-hub reply …`, which is not a
# command it has, so the path it was invoked by is kept instead. Both tests are parameter expansions or shell
# builtins, so the hook path below pays no fork for this.
if [ -z "${AGENT_HUB_INVOKED_AS:-}" ]; then
    AGENT_HUB_INVOKED_AS="${0##*/}"
    case "$0" in
        */*) command -v "$AGENT_HUB_INVOKED_AS" >/dev/null 2>&1 || AGENT_HUB_INVOKED_AS="$0" ;;
    esac
fi
export AGENT_HUB_INVOKED_AS

if [ "${1:-}" = "hook" ]; then
    # A hook must never fail or slow the session: every exit below is 0.
    [ -n "${AGENT_HUB_CHILD:-}" ] && exit 0
    [ -t 0 ] && exit 0
    input=$(cat)
    # HOME is defaulted for the same reason it is below: `set -u` aborts on an unset one, and this
    # block must never fail a hook.
    hub="${CLAUDE_CONFIG_DIR:-${HOME:-}/.claude}/agent-hub"
    sid=""
    re='"session_id"[[:space:]]*:[[:space:]]*"([A-Za-z0-9_-]+)"'
    if [[ "$input" =~ $re ]]; then
        sid="${BASH_REMATCH[1]}"
    fi
    # Whether this invocation has to print a decision rather than nothing. A PreToolUse hook that prints nothing
    # is read by Claude Code as "no decision", so AskUserQuestion's prompt is drawn — and in a pod or an Assistant
    # conversation nobody is there to answer it, which is the forever-busy session this hook exists to prevent.
    # Everything below that would otherwise exit 0 printing nothing checks this first. It is the bash copy of
    # mustDeny() in src/hooks.ts; src/bin.test.ts holds the two in step.
    must_decide=0
    if [ "${2:-}" = "PreToolUse" ] &&
        { [ -n "${AGENT_HUB_CONVERSATION_ID:-}" ] ||
            { [ -n "${AGENT_HUB_VIRTUAL_AGENT_ID:-}" ] && [ -n "${AGENT_HUB_LAUNCH_TOKEN:-}" ]; }; }; then
        # Both patterns are held in variables, which is the form bash 3.2 reads as a regex rather than as literal
        # text; the session_id read above is written the same way.
        tool_re='"tool_name"[[:space:]]*:[[:space:]]*"AskUserQuestion"'
        name_re='"tool_name"'
        # A payload naming no tool at all counts as the tool: the hook is registered for that tool alone, so a body
        # this cannot read is a broken payload rather than some other tool's call.
        if [[ "$input" =~ $tool_re ]] || [[ ! "$input" =~ $name_re ]]; then
            must_decide=1
        fi
    fi
    # What this script prints when it cannot run the CLI, or the CLI ran and said nothing: the JSON the CLI would
    # have printed for UNDELIVERED_REASON in src/questions.ts, written out again because bash cannot call it.
    # src/bin.test.ts holds the two copies in step.
    deny='{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"This question could not be put on screen, and there is nobody at a terminal to answer the prompt. Ask it in plain words in your reply instead, listing the choices, and end your turn so the person can answer with a message."}}'
    if [ -n "$sid" ] && [ ! -f "$hub/$sid/enabled" ]; then
        pending=0
        case "${2:-}:${AGENT_HUB_AUTO_ENABLE:-}" in
            SessionStart:[Tt][Rr][Uu][Ee] | SessionStart:1 | SessionStart:[Yy][Ee][Ss] | \
            UserPromptSubmit:[Tt][Rr][Uu][Ee] | UserPromptSubmit:1 | UserPromptSubmit:[Yy][Ee][Ss])
                [ -f "$hub/$sid/opted-out" ] || pending=1
                ;;
        esac
        # A virtual agent's SessionStart may have to say its repos are still arriving. This is the
        # bash copy of virtualAgent() in src/virtual-agent.ts; src/bin.test.ts holds the two in step.
        if [ "$pending" -eq 0 ] && [ "${2:-}" = "SessionStart" ] && [ -n "${AGENT_HUB_VIRTUAL_AGENT_ID:-}" ] && [ -n "${AGENT_HUB_LAUNCH_TOKEN:-}" ]; then
            pending=1
        fi
        # A question has to reach the CLI whatever the comms state: a session with comms off may still have a hub
        # it can reach, and the deny below is only the fallback for when it cannot. This is why nothing after here
        # can exit 0 printing nothing for a must_decide invocation — pending is set, so the exit below is not taken.
        if [ "$pending" -eq 0 ] && [ "$must_decide" -eq 1 ]; then
            pending=1
        fi
        # /clear starts a new session id; SessionStart must look for a handoff from the old one.
        if [ "$pending" -eq 0 ] && [ "${2:-}" = "SessionStart" ]; then
            for f in "$hub"/handoff/*.json; do
                [ -e "$f" ] && pending=1
                break
            done
        fi
        [ "$pending" -eq 1 ] || exit 0
    fi
    # Runs synchronously on every prompt, so node starts only when a held note is waiting.
    if [ "${2:-}" = "UserPromptContext" ]; then
        [ -n "$sid" ] && [ -s "$hub/$sid/held-notes.jsonl" ] || exit 0
    fi
    if [ "$must_decide" -eq 1 ]; then
        # The decision has to reach Claude Code whatever becomes of the CLI, so its output is captured and checked
        # rather than streamed: a missing dist/, a node that is not installed, a crash, an OOM kill and a run that
        # printed nothing all end up here, and every one of them used to let the prompt be drawn.
        out=""
        if command -v node >/dev/null 2>&1; then
            out=$(node "$CLI" "$@" <<<"$input" 2>/dev/null) || out=""
        fi
        case "$out" in
            *'"permissionDecision"'*) printf '%s\n' "$out" ;;
            *) printf '%s\n' "$deny" ;;
        esac
        exit 0
    fi
    command -v node >/dev/null 2>&1 || exit 0
    node "$CLI" "$@" <<<"$input" 2>/dev/null
    exit 0
fi

# PATH alone does not find node outside an interactive shell: the devcontainer base installs nvm with
# PROFILE=/dev/null and sources it from .bashrc and .zshrc only, so npm's global bin directory is missing from
# every `kubectl exec` into a pod and from every non-login non-interactive shell — `bash -lc` included. Reading a
# pod's client version and reporting a stuck session both failed on that. nvm.sh is sourced rather than searched
# for, as bin/virtual-agent-boot and virtual-agent/entrypoint.sh do; its own output is dropped, so nothing it says
# reaches a caller reading this command's stdout.
#
# Defined below the gate, which always exits, so no hook can reach it: the gate decides whether to start node
# without starting it, and a session that never enabled comms must pay nothing for this. The gate keeps its own
# `command -v node` and its exit 0 besides, because a hook must never fail or slow a session.
load_node() {
    command -v node >/dev/null 2>&1 && return 0
    # HOME is defaulted because `set -u` would abort on an unset one before the error below could explain itself,
    # and a process started with no shell in the way need not have HOME at all.
    export NVM_DIR="${NVM_DIR:-${HOME:-}/.nvm}"
    # nvm.sh reads variables it has not set, which `set -u` would abort on.
    set +u
    # shellcheck disable=SC1091
    # Only stdout is dropped. A half-installed nvm complains on stderr, and that complaint is the
    # one thing that tells an operator node is installed and nvm is what is broken.
    [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh" >/dev/null
    set -u
    command -v node >/dev/null 2>&1
}

if ! load_node; then
    printf 'agent-hub: node is not on PATH. Install Node 22 or later (the devcontainer ships it).\n' >&2
    exit 1
fi

exec node "$CLI" "$@"
