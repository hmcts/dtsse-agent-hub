#!/usr/bin/env bash
# Connect Claude Code sessions to agent-hub (hmcts/dtsse-agent-hub): direct messages
# between agents and people, topic boards, and an upload of each enabled session's transcript
# (agent-hub transcript off|on|status). Opt-in per session via /enable-comms, or
# automatic for interactive sessions when AGENT_HUB_AUTO_ENABLE is true.
#
# Usage: agent-hub <command> [args]     (agent-hub help for the list)
#
# The work is done by the compiled, dependency-free Node CLI beside this script. `hook` runs
# in every workspace session, so a session that never enabled comms costs one file test
# here and never starts node. With auto-enable on, SessionStart and UserPromptSubmit
# start node for a session that is neither enabled nor opted out. UserPromptContext
# starts it only when the stop worker has held a feed note for the next prompt.

set -u

# The CLI is found relative to this file, so every symlink in the way has to be followed first: npm installs a
# bin as a symlink from <prefix>/bin, and the unresolved directory holds no dist/. `readlink -f` would do it in
# one call but macOS ships a BSD readlink without -f, so the loop walks the chain itself; it costs one `[ -L ]`
# test for a real path, which is what the hooks always have.
target="${BASH_SOURCE[0]}"
while [ -L "$target" ]; do
    link="$(readlink "$target")"
    case "$link" in
        /*) target="$link" ;;
        *) target="$(cd "$(dirname "$target")" && pwd)/$link" ;;
    esac
done
HERE="$(cd "$(dirname "$target")" && pwd)"
CLI="${AGENT_HUB_CLI_JS:-$HERE/../dist/cli.js}"
# How the CLI names itself in the commands it tells anyone to run. A wrapper that wants its own spelling sets
# this before calling. Otherwise the bare name is used only when it resolves to something: a machine whose only
# agent-hub is cft-workspace's `scripts/agent-hub` shim was told to run `agent-hub reply …`, which is not a
# command it has, so the path it was invoked by is kept instead. Both tests are parameter expansions or shell
# builtins, so the hook path below pays no fork for this.
if [ -z "${AGENT_HUB_INVOKED_AS:-}" ]; then
    AGENT_HUB_INVOKED_AS="${0##*/}"
    case "$0" in
        */*) command -v "$AGENT_HUB_INVOKED_AS" >/dev/null 2>&1 || AGENT_HUB_INVOKED_AS="$0" ;;
    esac
fi
export AGENT_HUB_INVOKED_AS

if [ "${1:-}" = "hook" ]; then
    # A hook must never fail or slow the session: every exit below is 0.
    [ -n "${AGENT_HUB_CHILD:-}" ] && exit 0
    [ -t 0 ] && exit 0
    input=$(cat)
    hub="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/agent-hub"
    sid=""
    re='"session_id"[[:space:]]*:[[:space:]]*"([A-Za-z0-9_-]+)"'
    if [[ "$input" =~ $re ]]; then
        sid="${BASH_REMATCH[1]}"
    fi
    if [ -n "$sid" ] && [ ! -f "$hub/$sid/enabled" ]; then
        pending=0
        case "${2:-}:${AGENT_HUB_AUTO_ENABLE:-}" in
            SessionStart:[Tt][Rr][Uu][Ee] | SessionStart:1 | SessionStart:[Yy][Ee][Ss] | \
            UserPromptSubmit:[Tt][Rr][Uu][Ee] | UserPromptSubmit:1 | UserPromptSubmit:[Yy][Ee][Ss])
                [ -f "$hub/$sid/opted-out" ] || pending=1
                ;;
        esac
        # A virtual agent's SessionStart may have to say its repos are still arriving. This is the
        # bash copy of virtualAgent() in src/virtual-agent.ts; src/bin.test.ts holds the two in step.
        if [ "$pending" -eq 0 ] && [ "${2:-}" = "SessionStart" ] && [ -n "${AGENT_HUB_VIRTUAL_AGENT_ID:-}" ] && [ -n "${AGENT_HUB_LAUNCH_TOKEN:-}" ]; then
            pending=1
        fi
        # /clear starts a new session id; SessionStart must look for a handoff from the old one.
        if [ "$pending" -eq 0 ] && [ "${2:-}" = "SessionStart" ]; then
            for f in "$hub"/handoff/*.json; do
                [ -e "$f" ] && pending=1
                break
            done
        fi
        [ "$pending" -eq 1 ] || exit 0
    fi
    # Runs synchronously on every prompt, so node starts only when a held note is waiting.
    if [ "${2:-}" = "UserPromptContext" ]; then
        [ -n "$sid" ] && [ -s "$hub/$sid/held-notes.jsonl" ] || exit 0
    fi
    command -v node >/dev/null 2>&1 || exit 0
    node "$CLI" "$@" <<<"$input" 2>/dev/null
    exit 0
fi

if ! command -v node >/dev/null 2>&1; then
    printf 'agent-hub: node is not on PATH. Install Node 22 or later (the devcontainer ships it).\n' >&2
    exit 1
fi

exec node "$CLI" "$@"
