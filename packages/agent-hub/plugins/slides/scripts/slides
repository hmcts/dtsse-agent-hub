#!/usr/bin/env bash
# HMCTS-branded PowerPoint decks from an outline.
#
# Subcommands:
#   layouts                                 the layouts, their fields and limits, as JSON
#   build <outline.json> --out <file.pptx>  check the outline and write the deck
#
# Guide: the plugin's README.md
#
# JSON result on stdout, commentary and warnings on stderr. Exit 2 for an outline
# or arguments that need fixing. Needs Node 22.18+ (runs the TypeScript sources
# directly); dependencies install on first run, or with `slides deps`, which
# installs them and does nothing else.

set -euo pipefail

LIB="$(cd "$(dirname "$0")/slides-lib" && pwd)"
READY="$LIB/node_modules/.slides-ready"

# The marker is written only once npm ci has finished, and npm ci empties
# node_modules first, so a run that was stopped halfway is installed again
# rather than taken for done. flock keeps two first runs from installing into the
# same directory at once; the lock goes with the process, so a killed install
# leaves none behind. Without flock (macOS), runs install unguarded.
install_deps() {
  [[ -f "$READY" ]] && return 0
  echo "slides: installing dependencies (first run)…" >&2
  (cd "$LIB" && npm ci --silent --no-audit --no-fund) >&2
  touch "$READY"
}

if [[ ! -f "$READY" ]]; then
  if command -v flock >/dev/null 2>&1; then
    exec 9>"$LIB/.install.lock"
    flock 9
    install_deps
    flock -u 9
    exec 9>&-
  else
    install_deps
  fi
fi

if [[ "${1:-}" == "deps" ]]; then
  exit 0
fi

exec node --no-warnings=ExperimentalWarning "$LIB/cli.ts" "$@"
