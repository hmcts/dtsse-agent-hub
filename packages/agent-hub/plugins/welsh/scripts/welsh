#!/usr/bin/env bash
# Welsh translation tooling for BAs, for every CFT service.
#
# Subcommands (run with --help for options):
#   init           set up welsh/ (catalogue, config, returns) in the service's home repo
#   info           what a service has set up: its repos and its catalogue's counts
#   search         search a service's catalogue, English or Welsh side
#   import-legacy  seed a catalogue from an existing WLU spreadsheet and/or JSON map
#   scan           find English without Welsh in a service's repos; --request writes the WLU xlsx
#   story          add or refresh the "Welsh content" section of a Jira story
#   import         add a WLU return to the catalogue (each Ref re-checked against its English)
#   apply          write approved Welsh into a clone on a branch; --pr opens a draft PR
#   verify         prove every Welsh value a branch changed came from the WLU
#
# Guide: docs/how-to/manage-welsh-translations.md in cft-workspace
#
# Welsh text only ever comes from the Welsh Language Unit — either a catalogue
# row or a returned spreadsheet. Nothing here translates.
#
# JSON result on stdout, commentary on stderr. Needs Node 22.18+ (runs the
# TypeScript sources directly); dependencies install on first run, or with
# `welsh deps`, which installs them and does nothing else.

set -euo pipefail

LIB="$(cd "$(dirname "$0")/welsh-lib" && pwd)"
READY="$LIB/node_modules/.welsh-ready"

# The marker is written only once npm ci has finished, and npm ci empties
# node_modules first, so a run that was stopped halfway is installed again
# rather than taken for done. flock keeps two first runs from installing into the
# same directory at once; the lock goes with the process, so a killed install
# leaves none behind. Without flock (macOS), runs install unguarded.
install_deps() {
  [[ -f "$READY" ]] && return 0
  echo "welsh: installing dependencies (first run)…" >&2
  (cd "$LIB" && npm ci --silent --no-audit --no-fund) >&2
  touch "$READY"
}

if [[ ! -f "$READY" ]]; then
  if command -v flock >/dev/null 2>&1; then
    exec 9>"$LIB/.install.lock"
    flock 9
    install_deps
    flock -u 9
    exec 9>&-
  else
    install_deps
  fi
fi

if [[ "${1:-}" == "deps" ]]; then
  exit 0
fi

exec node --no-warnings=ExperimentalWarning "$LIB/cli.ts" "$@"
