    <decisionTable id="DecisionTable_0jtevuc" hitPolicy="COLLECT">
      <input id="Input_1" label="Event Id" biodi:width="267" camunda:inputVariable="eventId">
        <inputExpression id="InputExpression_1" typeRef="string">
          <text></text>
        </inputExpression>
      </input>
      <input id="InputClause_0gxli97" label="Post event state" biodi:width="428" camunda:inputVariable="postEventState">
        <inputExpression id="LiteralExpression_0dijl5x" typeRef="string">
          <text></text>
        </inputExpression>
      </input>
      <input id="InputClause_1nkkapg" label="Refer Case To" biodi:width="150" camunda:inputVariable="referCaseTo">
        <inputExpression id="LiteralExpression_1h40nek" typeRef="string">
          <text>if(additionalData!=null
and additionalData.Data!=null
and additionalData.Data.referralCollection!=null
and count(additionalData.Data.referralCollection) &gt; 0)
then sort(additionalData.Data.referralCollection, function(x,y) number(x.value.referralNumber) &gt; number(y.value.referralNumber)).value.referCaseTo[1]
else null</text>
        </inputExpression>
      </input>
      <input id="InputClause_1idexf5" label="Referral Subject" biodi:width="220" camunda:inputVariable="referralSubject">
        <inputExpression id="LiteralExpression_0tjv49t" typeRef="string">
          <text>if(additionalData!=null
and additionalData.Data!=null
and additionalData.Data.referralCollection!=null
and count(additionalData.Data.referralCollection) &gt; 0)
then sort(additionalData.Data.referralCollection, function(x,y) number(x.value.referralNumber) &gt; number(y.value.referralNumber)).value.referralSubject[1]
else null</text>
        </inputExpression>
      </input>
      <input id="InputClause_1jc2my4" label="Update Directed To" camunda:inputVariable="updateReferCaseTo">
        <inputExpression id="LiteralExpression_1x15f9w" typeRef="string">
          <text>if(additionalData!=null
and additionalData.Data!=null
and additionalData.Data.referralCollection!=null
and count(additionalData.Data.referralCollection[count(value.updateReferralCollection)&gt;0])&gt;0)
then sort(flatten(additionalData.Data.referralCollection[value.updateReferralCollection!=null].value.updateReferralCollection), function(x,y) date and time(if(x.value.updateReferralDateTime!=null)then x.value.updateReferralDateTime else "2023-01-01T00:00:00.000") &gt; date and time(if(y.value.updateReferralDateTime!=null)then y.value.updateReferralDateTime else "2023-01-01T00:00:00.000")).value.updateReferCaseTo[1]
else null</text>
        </inputExpression>
      </input>
      <input id="InputClause_1gia5s6" label="Direction To" biodi:width="150" camunda:inputVariable="directionTo">
        <inputExpression id="LiteralExpression_1tb9c3z" typeRef="string">
          <text>if(additionalData!=null
and additionalData.Data!=null
and additionalData.Data.referralCollection!=null
and count(additionalData.Data.referralCollection[count(value.referralReplyCollection)&gt;0])&gt;0)
then sort(flatten(additionalData.Data.referralCollection[value.referralReplyCollection!=null].value.referralReplyCollection), function(x,y) date and time(if(x.value.replyDateTime!=null)then x.value.replyDateTime else "2023-01-01T00:00:00.000") &gt; date and time(if(y.value.replyDateTime!=null)then y.value.replyDateTime else "2023-01-01T00:00:00.000")).value.directionTo[1]
else null</text>
        </inputExpression>
      </input>
      <input id="InputClause_1xga2us" label="ET3 form received">
        <inputExpression id="LiteralExpression_03vw0p2" typeRef="boolean">
          <text>if(additionalData!=null
and additionalData.Data!=null
and additionalData.Data.respondentCollection!=null
and count(additionalData.Data.respondentCollection)&gt;0)
then
  if(additionalData.Data.respondentCollection[1].value.responseReceived)
  then
    if(additionalData.Data.respondentCollection[1].value.responseReceivedCount="1")
    then true
    else false
  else false
else false</text>
        </inputExpression>
      </input>
      <input id="InputClause_18qp9rh" label="Is There An Et3 Response">
        <inputExpression id="LiteralExpression_1y14227" typeRef="boolean">
          <text>if(additionalData!=null
and additionalData.Data!=null
and additionalData.Data.respondentCollection!=null
and count(additionalData.Data.respondentCollection) &gt; 0)
then some item in additionalData.Data.respondentCollection satisfies (item.value.et3Vetting != null and item.value.et3Vetting.et3IsThereAnEt3Response = true)
else false</text>
        </inputExpression>
      </input>
      <input id="InputClause_0r1wqre" label="Is ECC">
        <inputExpression id="LiteralExpression_1vk0scy" typeRef="boolean">
          <text>if(additionalData!=null
and additionalData.Data!=null
and additionalData.Data.respondentCollection!=null
and count(additionalData.Data.respondentCollection) &gt; 0)
then some item in additionalData.Data.respondentCollection satisfies (item.value.et3Vetting != null and item.value.et3Vetting.et3ContractClaimSection7 = true)
else false</text>
        </inputExpression>
      </input>
      <input id="InputClause_1p24pi6" label="Is ECC Reply Received">
        <inputExpression id="LiteralExpression_05mg3no" typeRef="boolean">
          <text>if (
  additionalData != null
  and additionalData.Data != null
  and additionalData.Data.respondentCollection != null
  and count(additionalData.Data.respondentCollection) &gt; 0
)
then
  some item in additionalData.Data.respondentCollection satisfies (
    item.value.respondentEccReplyCount = "1"
  )
else false</text>
        </inputExpression>
      </input>
      <input id="InputClause_97c7601b" label="Respondent ECC Reply">
        <inputExpression id="LiteralExpression_7a8dbe72" typeRef="boolean">
          <text>if(additionalData!=null
and additionalData.Data!=null
and additionalData.Data.respondentCollection!=null
and count(additionalData.Data.respondentCollection) &gt; 0
and additionalData.Data.respondentCollection[1].value.et3Vetting!=null)
then additionalData.Data.respondentCollection[1].value.et3Vetting.et3ResponseEccYes
else null</text>
        </inputExpression>
      </input>
      <input id="InputClause_1hr458y" label="List A Hearing">
        <inputExpression id="LiteralExpression_08h2bgb" typeRef="boolean">
          <text>if(additionalData.Data.etICHearingNotListedListUpdated!=null
and count(additionalData.Data.etICHearingNotListedListUpdated) &gt; 0
and (list contains(additionalData.Data.etICHearingNotListedListUpdated, "List for preliminary hearing")
or list contains(additionalData.Data.etICHearingNotListedListUpdated, "List for final hearing")))
then true
else false</text>
        </inputExpression>
      </input>
      <input id="InputClause_0w8if58" label="Strike Out Claim/Strike Out Response">
        <inputExpression id="LiteralExpression_1o6638k" typeRef="string">
          <text>if(additionalData != null
and additionalData.Data != null
and additionalData.Data.etInitialConsiderationRule27 != null
and additionalData.Data.etInitialConsiderationRule27.etICRule27ClaimToBe != null)
then additionalData.Data.etInitialConsiderationRule27.etICRule27ClaimToBe
else if (additionalData != null
and additionalData.Data != null
and additionalData.Data.etInitialConsiderationRule28 != null
and additionalData.Data.etInitialConsiderationRule28.etICRule28ClaimToBe != null)
then additionalData.Data.etInitialConsiderationRule28.etICRule28ClaimToBe
else null</text>
        </inputExpression>
      </input>
      <input id="InputClause_0ps66wm" label="Hearings Heard">
        <inputExpression id="LiteralExpression_13al11j" typeRef="boolean">
          <text>additionalData!=null
and additionalData.Data!=null
and additionalData.Data.hearingDetailsCollection!=null
and count(additionalData.Data.hearingDetailsCollection)&gt;0
and (some x in additionalData.Data.hearingDetailsCollection satisfies x.value.hearingDetailsStatus="Heard")
and (every x in additionalData.Data.hearingDetailsCollection satisfies (x.value.hearingDetailsStatus="Heard" or x.value.hearingDetailsStatus="Vacated" or x.value.hearingDetailsStatus="Postponed"))</text>
        </inputExpression>
      </input>
      <input id="InputClause_0z98r1i" label="Submission Reason (Application)" biodi:width="313">
        <inputExpression id="LiteralExpression_1ebb1do" typeRef="string">
          <text>if(additionalData!=null
and additionalData.Data!=null
and additionalData.Data.genericTseApplicationCollection!=null
and count(additionalData.Data.genericTseApplicationCollection) &gt; 0)
then sort(additionalData.Data.genericTseApplicationCollection,function(x,y) number(x.value.number) &gt; number(y.value.number)).value.type[1]
else null</text>
        </inputExpression>
      </input>
      <input id="InputClause_0w8d76g" label="Application Response From">
        <inputExpression id="LiteralExpression_1ks5p0n" typeRef="string">
          <text>if(additionalData!=null
and additionalData.Data!=null
and additionalData.Data.genericTseApplicationCollection!=null
and count(additionalData.Data.genericTseApplicationCollection[value.respondCollection!=null])&gt;0)
then sort(flatten(additionalData.Data.genericTseApplicationCollection[value.respondCollection!=null].value.respondCollection), function(x,y) date and time(if(x.value.dateTime!=null)then x.value.dateTime else "2023-01-01T00:00:00.000") &gt; date and time(if(y.value.dateTime!=null)then y.value.dateTime else "2023-01-01T00:00:00.000"))[1].value.from
else null</text>
        </inputExpression>
      </input>
      <input id="InputClause_1ki9c2f" label="Response to Application Type" biodi:width="270">
        <inputExpression id="LiteralExpression_0egdmqz" typeRef="string">
          <text>if(additionalData!=null
and additionalData.Data!=null
and additionalData.Data.genericTseApplicationCollection!=null
and count(additionalData.Data.genericTseApplicationCollection[value.respondCollection!=null])&gt;0)
then sort(flatten(additionalData.Data.genericTseApplicationCollection[value.respondCollection!=null].value.respondCollection), function(x,y) date and time(if(x.value.dateTime!=null)then x.value.dateTime else "2023-01-01T00:00:00.000") &gt; date and time(if(y.value.dateTime!=null)then y.value.dateTime else "2023-01-01T00:00:00.000"))[1].value.applicationType
else null</text>
        </inputExpression>
      </input>
      <input id="InputClause_16vtjv4" label="Notification Response is ECC from Claimant">
        <inputExpression id="LiteralExpression_1hsr3p7" typeRef="boolean">
          <text>LATEST_NOTIFICATION_RESPONSE_IS_ECC_FROM_CLAIMANT</text>
        </inputExpression>
      </input>
      <input id="InputClause_0833q0e" label="Is Judgment Or Order">
        <inputExpression id="LiteralExpression_130ucvr" typeRef="boolean">
          <text>if(additionalData!=null
and additionalData.Data!=null
and additionalData.Data.draftAndSignJudgement!=null
and additionalData.Data.draftAndSignJudgement.isJudgement!=null)
  then additionalData.Data.draftAndSignJudgement.isJudgement
else false</text>
        </inputExpression>
      </input>
      <input id="Input_support_admin_scot" label="Admin Support Task Required">
        <inputExpression id="InputExpression_support_admin_scot" typeRef="boolean">
          <text>if(additionalData!=null
and additionalData.Data!=null
and additionalData.Data.supportTaskState!=null
and additionalData.Data.supportTaskState.adminTaskRequired!=null)
then additionalData.Data.supportTaskState.adminTaskRequired=true
else false</text>
        </inputExpression>
      </input>
      <input id="Input_support_legalofficer_scot" label="Legal Officer Support Task Required">
        <inputExpression id="InputExpression_support_legalofficer_scot" typeRef="boolean">
          <text>if(additionalData!=null
and additionalData.Data!=null
and additionalData.Data.supportTaskState!=null
and additionalData.Data.supportTaskState.legalOfficerTaskRequired!=null)
then additionalData.Data.supportTaskState.legalOfficerTaskRequired=true
else false</text>
        </inputExpression>
      </input>
      <input id="Input_support_judge_scot" label="Judge Support Task Required">
        <inputExpression id="InputExpression_support_judge_scot" typeRef="boolean">
          <text>if(additionalData!=null
and additionalData.Data!=null
and additionalData.Data.supportTaskState!=null
and additionalData.Data.supportTaskState.judgeTaskRequired!=null)
then additionalData.Data.supportTaskState.judgeTaskRequired=true
else false</text>
        </inputExpression>
      </input>
      <input id="Input_arrange_support_scot" label="Arrange Support Task Required">
        <inputExpression id="InputExpression_arrange_support_scot" typeRef="boolean">
          <text>ARRANGE_SUPPORT_TASK_NAME != null</text>
        </inputExpression>
      </input>
