  <decision id="Decision_0mhlyhp" name="LATEST_APPLICATION_TASK_NAME">
    <variable id="InformationItem_0l35pxs" name="LATEST_APPLICATION_TASK_NAME" typeRef="string" />
    <informationRequirement id="InformationRequirement_1h7r97o">
      <requiredDecision href="#Decision_1yxg1fw" />
    </informationRequirement>
    <literalExpression id="LiteralExpression_0gvbaj1">
      <text>if(LATEST_APPLICATION_TYPE!=null)
  then if(LATEST_APPLICATION_TYPE="Contact about something else" or LATEST_APPLICATION_TYPE ="Contact the tribunal")
    then "Contact the tribunal"
    else "Review Application - " + LATEST_APPLICATION_TYPE
  else null</text>
    </literalExpression>
  </decision>
  <decision id="Decision_1yxg1fw" name="LATEST_APPLICATION_TYPE">
    <variable id="InformationItem_177x00h" name="LATEST_APPLICATION_TYPE" typeRef="string" />
    <literalExpression id="LiteralExpression_0jmjjs6">
      <text>if(additionalData!=null
and additionalData.Data!=null
and additionalData.Data.genericTseApplicationCollection!=null
and count(additionalData.Data.genericTseApplicationCollection) &gt; 0)
then sort(additionalData.Data.genericTseApplicationCollection,function(x,y) number(x.value.number) &gt; number(y.value.number)).value.type[1]
else null</text>
    </literalExpression>
  </decision>
  <decision id="Decision_10dijkm" name="LATEST_APPLICATION_RESPOND_TYPE">
    <variable id="InformationItem_1enqaet" name="LATEST_APPLICATION_RESPOND_TYPE" typeRef="string" />
    <literalExpression id="LiteralExpression_1inyejd">
      <text>if(additionalData!=null
and additionalData.Data!=null
and additionalData.Data.genericTseApplicationCollection!=null
and count(additionalData.Data.genericTseApplicationCollection[value.respondCollection!=null])&gt;0)
then sort(
  flatten(additionalData.Data.genericTseApplicationCollection[value.respondCollection!=null].value.respondCollection),
  function(x,y)
    date and time(if(x.value.dateTime!=null)then x.value.dateTime else "2023-01-01T00:00:00.000")
    &gt;
    date and time(if(y.value.dateTime!=null)then y.value.dateTime else "2023-01-01T00:00:00.000")
)[1].value.applicationType
else null</text>
    </literalExpression>
  </decision>
  <decision id="Decision_1uzjxz3" name="LATEST_APPLICATION_RESPOND_TASK_NAME">
    <variable id="InformationItem_06lxh2u" name="LATEST_APPLICATION_RESPOND_TASK_NAME" typeRef="string" />
    <informationRequirement id="InformationRequirement_1qqzkui">
      <requiredDecision href="#Decision_10dijkm" />
    </informationRequirement>
    <literalExpression id="LiteralExpression_0b3dykm">
      <text>if(LATEST_APPLICATION_RESPOND_TYPE!=null)
  then if(LATEST_APPLICATION_RESPOND_TYPE="Contact about something else" or LATEST_APPLICATION_RESPOND_TYPE="Contact the tribunal")
    then "Contact the tribunal Response"
    else "Review Application Response - " + LATEST_APPLICATION_RESPOND_TYPE
  else null</text>
    </literalExpression>
  </decision>
  <decision id="Decision_14sdj4h" name="LATEST_NOTIFICATION_RESPONSE_IS_ECC_FROM_CLAIMANT">
    <variable id="InformationItem_184v5r5" name="LATEST_NOTIFICATION_RESPONSE_IS_ECC_FROM_CLAIMANT" typeRef="boolean" />
    <informationRequirement id="InformationRequirement_10u30og">
      <requiredDecision href="#Decision_0jt8p9l" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_1q6giso">
      <requiredDecision href="#Decision_06g5z3o" />
    </informationRequirement>
    <literalExpression id="LiteralExpression_0urq14a">
      <text>(LATEST_NOTIFICATION_RESPONSE_IS_ECC and LATEST_NOTIFICATION_RESPONSE_IS_FROM_CLAIMANT)</text>
    </literalExpression>
  </decision>
  <decision id="Decision_0jt8p9l" name="LATEST_NOTIFICATION_RESPONSE_IS_ECC">
    <variable id="InformationItem_1r6zcsq" name="LATEST_NOTIFICATION_RESPONSE_IS_ECC" typeRef="boolean" />
    <literalExpression id="LiteralExpression_1febdn7">
      <text>if(additionalData!=null
and additionalData.Data!=null
and additionalData.Data.sendNotificationCollection!=null
and count(additionalData.Data.sendNotificationCollection[number(value.sendNotificationResponsesCount)&gt;0])&gt;0)

then (sort(
flatten(additionalData.Data.sendNotificationCollection[number(value.sendNotificationResponsesCount)&gt;0].value.respondCollection),
function(x,y)
date and time(if(x.value.dateTime!=null)then x.value.dateTime else "2023-01-01T00:00:00.000")
&gt;
date and time(if(y.value.dateTime!=null)then y.value.dateTime else "2023-01-01T00:00:00.000")
)[1].value.isECC="Yes")

else false</text>
    </literalExpression>
  </decision>
  <decision id="Decision_06g5z3o" name="LATEST_NOTIFICATION_RESPONSE_IS_FROM_CLAIMANT">
    <variable id="InformationItem_04e4n9l" name="LATEST_NOTIFICATION_RESPONSE_IS_FROM_CLAIMANT" typeRef="boolean" />
    <literalExpression id="LiteralExpression_1vz4bkg">
      <text>if(additionalData!=null
and additionalData.Data!=null
and additionalData.Data.sendNotificationCollection!=null
and count(additionalData.Data.sendNotificationCollection[number(value.sendNotificationResponsesCount)&gt;0])&gt;0)

then (sort(
flatten(additionalData.Data.sendNotificationCollection[number(value.sendNotificationResponsesCount)&gt;0].value.respondCollection),
function(x,y)
date and time(if(x.value.dateTime!=null)then x.value.dateTime else "2023-01-01T00:00:00.000")
&gt;
date and time(if(y.value.dateTime!=null)then y.value.dateTime else "2023-01-01T00:00:00.000")
)[1].value.from="Claimant")

else false</text>
    </literalExpression>
  </decision>
  <decision id="Decision_1komswz" name="CURRENT_REFERRAL_SERIAL_NUMBER">
    <variable id="InformationItem_0snok9l" name="CURRENT_REFERRAL_SERIAL_NUMBER" typeRef="string" />
    <literalExpression id="LiteralExpression_0f6ea87">
      <text>if(additionalData!=null
and additionalData.Data!=null
and additionalData.Data.referralCollection!=null
and count(additionalData.Data.referralCollection) &gt; 0
and sort(additionalData.Data.referralCollection,function(x,y) number(x.value.referralNumber)&gt;number(y.value.referralNumber))[1].value.referralNumber!=null)
then sort(
  additionalData.Data.referralCollection,
  function(x,y)
    number(x.value.referralNumber)
    &gt;
    number(y.value.referralNumber)
)[1].value.referralNumber
else ""</text>
    </literalExpression>
  </decision>
  <decision id="Decision_01k2es5" name="CURRENT_REFERRAL_SUBJECT">
    <variable id="InformationItem_0pa4934" name="CURRENT_REFERRAL_SUBJECT" typeRef="string" />
    <literalExpression id="LiteralExpression_19dcw3y">
      <text>if(additionalData!=null
and additionalData.Data!=null
and additionalData.Data.referralCollection!=null
and count(additionalData.Data.referralCollection) &gt; 0)
then (
  if(sort(additionalData.Data.referralCollection, function(x,y) number(x.value.referralNumber)&gt;number(y.value.referralNumber))[1].value.referralSubject = "Other")
  then (
    if(sort(additionalData.Data.referralCollection, function(x,y) number(x.value.referralNumber)&gt;number(y.value.referralNumber))[1].value.referralSubjectSpecify != null)
    then sort(additionalData.Data.referralCollection, function(x,y) number(x.value.referralNumber)&gt;number(y.value.referralNumber))[1].value.referralSubjectSpecify
    else "Other"
  )
  else sort(additionalData.Data.referralCollection, function(x,y) number(x.value.referralNumber)&gt;number(y.value.referralNumber))[1].value.referralSubject
)
else ""</text>
    </literalExpression>
  </decision>
  <decision id="Decision_0ivu6kl" name="CURRENT_REFERRAL_RESPONSE_SERIAL_NUMBER">
    <variable id="InformationItem_0ja06f5" name="CURRENT_REFERRAL_RESPONSE_SERIAL_NUMBER" typeRef="string" />
    <literalExpression id="LiteralExpression_1iv4liu">
      <text>if(additionalData!=null
and additionalData.Data!=null
and additionalData.Data.referralCollection!=null
and count(additionalData.Data.referralCollection[value.referralReplyCollection != null and count(value.referralReplyCollection)&gt;0])&gt;0)
then (
  sort(
    flatten(additionalData.Data.referralCollection[value.referralReplyCollection!=null and count(value.referralReplyCollection) &gt; 0].value.referralReplyCollection),
    function(x,y)
      date and time(if(x.value.replyDateTime!=null) then x.value.replyDateTime else "0001-01-01T00:00:00")
      &gt;
      date and time(if(y.value.replyDateTime!=null) then y.value.replyDateTime else "0001-01-01T00:00:00")
  )[1].value.referralNumber
)
else ""


</text>
    </literalExpression>
  </decision>
  <decision id="Decision_13xjrb4" name="CURRENT_REFERRAL_RESPONSE_SUBJECT">
    <variable id="InformationItem_1qqnn8q" name="CURRENT_REFERRAL_RESPONSE_SUBJECT" typeRef="string" />
    <literalExpression id="LiteralExpression_0c8yc8q">
      <text>if(additionalData != null and additionalData.Data != null and additionalData.Data.referralCollection != null and count(additionalData.Data.referralCollection[value.referralReplyCollection != null and count(value.referralReplyCollection) &gt; 0]) &gt; 0)
then
  if(
    (additionalData.Data.referralCollection[value.referralNumber = sort(flatten(additionalData.Data.referralCollection[value.referralReplyCollection != null].value.referralReplyCollection), function(x, y) date and time(x.value.replyDateTime) &gt; date and time(y.value.replyDateTime))[1].value.referralNumber][1].value.referralSubject) = "Other"
  )
  then
    if(
      (additionalData.Data.referralCollection[value.referralNumber = sort(flatten(additionalData.Data.referralCollection[value.referralReplyCollection != null].value.referralReplyCollection), function(x, y) date and time(x.value.replyDateTime) &gt; date and time(y.value.replyDateTime))[1].value.referralNumber][1].value.referralSubjectSpecify) != null
    )
    then
      (additionalData.Data.referralCollection[value.referralNumber = sort(flatten(additionalData.Data.referralCollection[value.referralReplyCollection != null].value.referralReplyCollection), function(x, y) date and time(x.value.replyDateTime) &gt; date and time(y.value.replyDateTime))[1].value.referralNumber][1].value.referralSubjectSpecify)
    else
      "Other"
  else
    (additionalData.Data.referralCollection[value.referralNumber = sort(flatten(additionalData.Data.referralCollection[value.referralReplyCollection != null].value.referralReplyCollection), function(x, y) date and time(x.value.replyDateTime) &gt; date and time(y.value.replyDateTime))[1].value.referralNumber][1].value.referralSubject)
else
  ""</text>
    </literalExpression>
  </decision>
  <decision id="Decision_1ju3q23" name="CURRENT_NOTIFICATION_NAME">
    <variable id="InformationItem_09yl1ar" name="CURRENT_NOTIFICATION_NAME" typeRef="string" />
    <literalExpression id="LiteralExpression_0zr0vet">
      <text>if additionalData != null
  and additionalData.Data != null
  and additionalData.Data.sendNotificationCollection != null
  and count(additionalData.Data.sendNotificationCollection[number(value.sendNotificationResponsesCount) &gt; 0]) &gt; 0
then (for r in [sort(
    for i in 1..count(additionalData.Data.sendNotificationCollection)
    return {
      position: i,
      latestDateTime: if(additionalData.Data.sendNotificationCollection[i].value.respondCollection != null
                        and count(additionalData.Data.sendNotificationCollection[i].value.respondCollection) &gt; 0)
                      then sort(
                          additionalData.Data.sendNotificationCollection[i].value.respondCollection,
                          function(a, b)
                            date and time(if(a.value.dateTime != null) then a.value.dateTime else "2023-01-01T00:00:00.000") &gt;
                            date and time(if(b.value.dateTime != null) then b.value.dateTime else "2023-01-01T00:00:00.000")
                        )[1].value.dateTime
                      else "2023-01-01T00:00:00.000"
    },
    function(x, y)
      date and time(if(x.latestDateTime != null) then x.latestDateTime else "2023-01-01T00:00:00.000") &gt;
      date and time(if(y.latestDateTime != null) then y.latestDateTime else "2023-01-01T00:00:00.000")
  )[1]]
  return if r != null and r.position != null
         then "Review notification " + string(r.position) + " response"
         else "Review notification response"
)[1]
else "Review notification response"</text>
    </literalExpression>
  </decision>
  <decision id="Decision_arrange_support_scot" name="ARRANGE_SUPPORT_TASK_NAME">
    <variable id="InformationItem_arrange_support_scot" name="ARRANGE_SUPPORT_TASK_NAME" typeRef="string" />
    <literalExpression id="LiteralExpression_arrange_support_scot">
      <text>if additionalData != null
and additionalData.Data != null
and additionalData.Data.supportTaskState != null
then additionalData.Data.supportTaskState.arrangeSupportTaskName
else null</text>
    </literalExpression>
  </decision>
