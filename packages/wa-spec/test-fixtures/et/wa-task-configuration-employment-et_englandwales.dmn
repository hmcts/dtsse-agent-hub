          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1u3n5td">
          <text>"location"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0kvxbku">
          <text>if (caseData.caseManagementLocation != null and caseData.caseManagementLocation.baseLocation != null) then caseData.caseManagementLocation.baseLocation else "369230"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_19bsupg">
          <text>true</text>
        </outputEntry>
      </rule>
